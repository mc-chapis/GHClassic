; The keyboard takes P1 from a solo guitar when its menu keys are used.
; On Multiplayer's screen the guitar can join it in the next seat.
#include common/first_boot.dta
(device guitar)
(press down guitar)
(expect {seat_has 0 guitar} 1)
(expect {main_screen focus_name} main_options.btn)
(key Down)
(expect {main_screen focus_name} quit.btn)
(key Up)
(expect {main_screen focus_name} main_options.btn)
(expect {seat_has 1 keyboard} 0)
(expect {seat_has 0 keyboard} 1)
{ui goto_screen multi_screen}
(wait_screen multi_screen)
(wait 1)
(press down guitar)
(expect {seat_has 1 guitar} 0)
(press start guitar)
(expect {seat_has 0 keyboard} 1)
(expect {seat_has 1 guitar} 1)
(expect {{ui current_screen} name} multi_screen)
; Its bound red (2) backs out, as P1's.
(key 2)
(wait_screen main_screen 10)
(quit)

; The keyboard claims P1 from a guitar before the song.
; Exercise pausing, resuming and restarting with the keyboard in its own seat.
#include common/first_boot.dta
(device guitar)
(press down guitar)
(expect {seat_has 0 guitar} 1)
(key Down)
(expect {seat_has 0 keyboard} 1)
{game set_song shoutatthedevil}
{{game get_player_config 0} set_difficulty easy}
{{game get_player_config 0} set autoplay TRUE}
{game set_quickplay}
{ui goto_screen loading_screen}
(wait_screen game_screen 60)
(wait 2)
(key Return)
(wait_screen pause_screen 10)
; Bound Start (Enter) pauses/resumes; bound green (1) confirms Restart.
(key Return)
(wait_screen game_screen 10)
(wait 2)
(key Return)
(wait_screen pause_screen 10)
(key Return)
(wait_screen game_screen 10)
(expect {seat_has 0 keyboard} 1)
(key Return)
(wait_screen pause_screen 10)
(key Down)
(wait 0.3)
(key 1)
(wait 3)
(expect {== {ui current_screen} game_screen} 1)
(key Return)
(wait_screen pause_screen 10)
(quit)

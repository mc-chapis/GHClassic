; Keyboard Mode can be changed in Controllers, keeps its keyboard identity
; and seat, and plays the next song as a DualShock or guitar as selected.
#include common/first_boot.dta
(key Down)
(expect {seat_has 0 keyboard} 1)
{ui goto_screen ghc_controllers_screen}
(wait_screen ghc_controllers_screen)
(wait 1)
(expect {ghc_controllers text title} KEYBOARD)
(key Up)
(key Up)
(expect {ghc_controllers text row {ghc_controllers focus}} MODE)
(expect {ghc_controllers text read {ghc_controllers focus}} GUITAR)
(key Return)
(wait 0.5)
(expect {ghc_controllers text read {ghc_controllers focus}} PAD)
(expect {ghc_controllers keyboard} 1)
(expect {ghc_controllers seat} 0)
(key Escape)
(wait_screen options_screen)
(wait 1)
{game set_song shoutatthedevil}
{{game get_player_config 0} set_difficulty easy}
{{game get_player_config 0} set autoplay TRUE}
{game set_quickplay}
{ui goto_screen loading_screen}
(wait_screen game_screen 60)
(wait 1)
(expect {game get_controller 0} joypad_guitar)
(expect {seat_has 0 keyboard} 1)
{meta_loading_nosave_goto main_screen}
(wait_screen main_screen 60)
(wait 1)
{ui goto_screen ghc_controllers_screen}
(wait_screen ghc_controllers_screen)
(wait 1)
(key Up)
(key Up)
(key Return)
(wait 0.5)
(expect {ghc_controllers text read {ghc_controllers focus}} GUITAR)
(expect {ghc_controllers keyboard} 1)
(key Escape)
(wait 1)
{game set_song shoutatthedevil}
{ui goto_screen loading_screen}
(wait_screen game_screen 60)
(wait 1)
(expect {game get_controller 0} guitar)
(quit)

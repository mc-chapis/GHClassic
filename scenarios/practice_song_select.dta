; Practice shares quickplay's setlist picker and engine toggle, retaining
; its part/difficulty/section/speed flow. Also runs with only GH2 mounted.
#include common/first_boot.dta
{gamecfg set mode practice}
{ui goto_screen practice_selsong_screen}
(wait_screen practice_selsong_screen)
(wait 2)
(expect {setlist shown} gh2)
(expect {gamecfg get practice_speed} 0)
{set $engine {note_engine next {note_engine}}}
(press blue)
(wait 1)
(expect {note_engine} $engine)
(expect {note_engine picked} $engine)
(shot engine)

; Hold yellow and strum: only the picker moves while it is open.
{set $at 0}
{foreach_int $i 0 {size {ghc_setlists}} {if {== {elem {ghc_setlists} $i} gh2} {set $at $i}}}
{set $want {elem {ghc_setlists} {mod {'+' $at 1} {size {ghc_setlists}}}}}
(hold 4096)
(wait 1)
(expect {ghc_pick_panel get open} {> {size {ghc_setlists}} 1})
(hold 4160)
(wait 0.3)
(hold 4096)
(wait 1)
(expect {game get_song_index} {if_else {> {size {ghc_setlists}} 1} 0 1})
(expect {setlist shown} gh2)
; Blue is consumed while the picker is open.
{if {ghc_pick_panel get open} {ghc_selsong_button kPad_Square training_screen}}
(expect {note_engine} $engine)
(hold 0)
(wait 3)
(expect {ghc_pick_panel get open} 0)
(expect {setlist shown} $want)

; Both copies of the screen offer Blue and Back.
{set $engine {note_engine next {note_engine}}}
(press blue)
(wait 1)
(expect {note_engine} $engine)
(press red)
(wait_screen training_screen)
(wait 1)
{ui goto_screen practice_selsong_screen}
(wait_screen practice_selsong_screen)
(wait 1)
(expect {setlist shown} $want)

; Select GH1 if present, exercising its converted Practice sections;
; otherwise the first song of the base game's setlist.
{set $want {if_else {mounted gh1} gh1 gh2}}
{set $at 0}
{foreach_int $i 0 {size {ghc_setlists}} {if {== {elem {ghc_setlists} $i} $want} {set $at $i}}}
(hold 4096)
(wait 1)
{if {ghc_pick_panel get open} {ghc_pick_panel step {'-' $at {ghc_pick_panel get picked}}}}
(hold 0)
(wait 3)
(expect {setlist shown} $want)
{set $song {song_provider get_symbol 0}}
{game set_song_index 0}
{if_else {== {ui current_screen} practice_selsong_screen}
   {sel_song_panel refresh}
   {sel_song_twin_panel refresh}
}
(press green)
(wait_screen practice_selpart_screen)
(expect {game get_song} $song)
(wait 1)
(press green)
(wait_screen practice_diff_screen)
(wait 1)
(press green)
(wait_screen practice_sel_section_screen)
(wait 2)
(shot sections)
(press green)
(wait_screen practice_sel_speed_screen)
(wait 1)
{{game get_player_config 0} set autoplay TRUE}
; One section at the slowest speed, keeping this check short.
{gamecfg set (practice_sections 0) 0}
{gamecfg set (practice_sections 1) 0}
(press down)
(press down)
(press down)
(press green)
(wait_screen practice_game_screen 60)
(expect {gamecfg get_song} $song)
(expect {gamecfg get practice_speed} 3)
(expect {note_engine} $engine)
(wait_screen practice_end_screen 180)
(expect {> {player0 gems_hit} 0} 1)
{meta_loading_nosave_goto practice_selsong_screen}
(wait_screen practice_selsong_screen 60)
(wait 1)
(expect {setlist shown} $want)
(expect {gamecfg get practice_speed} 0)
(shot returned)
(press red)
(wait_screen training_screen)
(quit)
